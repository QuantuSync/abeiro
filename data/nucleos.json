    ],
    "fuente_edad_concellos": "data/padron_edad_concellos.csv",
    "fuente_accesos": "data/accesos_osm.json (OpenStreetMap, ODbL).",
    "fuente_peligro": "data/pendiente_dem.json (EU-DEM 25 m) + data/ndvi_sentinel2.json + data/ndmi_sentinel2.json (Sentinel-2 S2_SR_HARMONIZED, Earth Engine); data/combustible_osm.json (OSM, ODbL) solo como respaldo."
  },
